#!/bin/sh
# mainframe-launch — open mainframe in a terminal, GUI auth via polkit.
# pkexec triggers the polkit auth dialog (separate window), which the on-screen
# keyboard on Phosh handles correctly. falls back to sudo on systems without polkit.

if [ "$(id -u)" -eq 0 ]; then
  AUTH=""
elif command -v pkexec >/dev/null 2>&1; then
  AUTH="pkexec"
else
  AUTH="sudo"
fi

CMD="$AUTH /usr/local/bin/mainframe"
HOLD="echo; read -p 'press enter to close...' _"

for term in kgx gnome-terminal xfce4-terminal konsole tilix lxterminal mate-terminal terminator alacritty kitty xterm; do
  if command -v "$term" >/dev/null 2>&1; then
    case "$term" in
      kgx|gnome-terminal|tilix)
        exec "$term" -- sh -c "$CMD; $HOLD"
        ;;
      konsole|alacritty|kitty)
        exec "$term" -e sh -c "$CMD; $HOLD"
        ;;
      *)
        exec "$term" -e "sh -c '$CMD; $HOLD'"
        ;;
    esac
  fi
done

echo "no terminal emulator found." >&2
exit 1
